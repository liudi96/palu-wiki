# 服务器配置
SERVER_PORT=8080
SERVER_MODE=debug

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=palu_user
DB_PASSWORD=palu_password
DB_NAME=palu_wiki
DB_SSLMODE=disable

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
JWT_SECRET=your-jwt-secret-key-here

# AI配置 - 按优先级配置，至少配置一个

# DeepSeek配置（优先级1）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通义千问配置（优先级2）
QWEN_API_KEY=your-qwen-api-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com
QWEN_MODEL=qwen-turbo

# 讯飞星火AI配置（优先级3，兜底）
SPARK_APP_ID=your-app-id-here
SPARK_API_KEY=your-api-key-here
SPARK_API_SECRET=your-api-secret-here
SPARK_DOMAIN=lite
SPARK_BASE_URL=wss://spark-api.xf-yun.com/v1.1/chat